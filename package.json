{
  "name": "solana-a2a-pay",
  "version": "0.1.0",
  "private": true,
  "description": "AI agents paying each other per HTTP request on Solana with an x402-style 402 flow",
  "type": "module",
  "scripts": {
    "setup": "tsx src/scripts/setup.ts",
    "data-agent": "tsx src/agents/data-agent.ts",
    "analyst-agent": "tsx src/agents/analyst-agent.ts",
    "orchestrator": "tsx src/agents/orchestrator.ts",
    "attack": "tsx src/scripts/attack.ts",
    "demo": "tsx src/scripts/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.98.0",
    "express": "4.21.2",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "tsx": "^4.23.15",
    "typescript": "5.7.2"
